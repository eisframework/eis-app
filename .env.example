# App
APP_NAME="Elysia Inertia App"
APP_ENV=development
APP_DEBUG=true
APP_KEY=change-this-to-a-random-32-character-string
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Database
DB_PATH=./database.sqlite

# Server
PORT=3000
HOST=localhost

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email Service Selection:
# To switch between Resend and SMTP, change the import in your controller:
#
# Resend:
import { send } from '../services/resend.service'
#
# SMTP:
import { send } from '../services/smtp.service'
#
# Both services have the same API, making it easy to switch between them.
# Resend is recommended for production, SMTP for development or custom mail servers.

# Email Configuration
EMAIL_FROM=no-reply@example.com

# Resend Configuration
RESEND_API_KEY=your-resend-api-key

# SMTP Configuration (alternative to Resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
